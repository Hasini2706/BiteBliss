<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://onlinefood.com/billing"
           xmlns:tns="http://onlinefood.com/billing"
           elementFormDefault="qualified">

    <xs:element name="GenerateBillRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="orderId" type="xs:long"/>
                <xs:element name="userId" type="xs:long"/>
                <xs:element name="totalAmount" type="xs:double"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GenerateBillResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="billId" type="xs:string"/>
                <xs:element name="orderId" type="xs:long"/>
                <xs:element name="amount" type="xs:double"/>
                <xs:element name="status" type="xs:string"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
